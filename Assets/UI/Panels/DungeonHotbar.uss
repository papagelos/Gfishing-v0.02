.dungeon-hotbar-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;

    height: 240px;

    flex-direction: row;
    justify-content: center;
    align-items: flex-end;

    padding-bottom: 18px;
    padding-left: 16px;
    padding-right: 16px;

    overflow: visible;
}

.dungeon-hotbar-strip {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    gap: 10px;

    padding: 10px 12px;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0.35);
}

.dungeon-slot {
    width: 170px;
    height: 170px;
    min-width: 170px;
    min-height: 170px;

    /* Square shell for skills while inheriting Village card visuals. */
    padding-bottom: 0;
    -unity-text-align: middle-center;
    font-size: 22px;

    color: rgba(255, 255, 255, 0.95);
}

.dungeon-slot.has-gem {
    border-color: rgba(100, 200, 255, 0.75);
    border-width: 2px;
}

.dungeon-gem-popup {
    position: absolute;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;

    min-width: 320px;
    max-width: 860px;
    padding: 10px;

    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(8, 10, 14, 0.94);
}

.dungeon-gem-popup-title {
    color: rgba(255, 255, 255, 0.96);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.dungeon-gem-popup-row {
    flex-direction: row;
    align-items: flex-end;
    gap: 8px;
    overflow: hidden;
}

.dungeon-gem-popup-empty {
    color: rgba(255, 220, 140, 0.95);
    font-size: 12px;
}

.dungeon-gem-choice {
    width: 110px;
    height: 110px;
    min-width: 110px;
    min-height: 110px;

    font-size: 11px;
    padding-bottom: 8px;
    -unity-text-align: lower-center;
}
